{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:base"
  ],
  "timezone": "Asia/Tokyo",
  "schedule": "before 2pm on Friday",
  "prHourlyLimit": 2,
  "rangeStrategy": "bump",
  "dependencyDashboard": false,
  "packageRules": [
    {
      "matchFileNames": [
        ".node-version"
      ],
      "enabled": false
    },
    {
      "matchUpdateTypes": [
        "patch",
        "minor"
      ],
      "excludePackageNames": [
        "typescript"
      ],
      "groupName": "minor and patch dependencies"
    }
  ]
}
